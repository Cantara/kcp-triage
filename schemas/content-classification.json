{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ContentClassification",
  "type": "object",
  "required": ["primaryCategory", "secondaryCategories", "confidence", "topics", "techStack", "reasoning"],
  "properties": {
    "primaryCategory": {
      "type": "string",
      "enum": ["ecommerce", "blog", "news", "saas", "portfolio", "documentation", "government", "education", "social", "forum", "other"]
    },
    "secondaryCategories": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["ecommerce", "blog", "news", "saas", "portfolio", "documentation", "government", "education", "social", "forum", "other"]
      }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "topics": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Key topics/themes identified on the site"
    },
    "techStack": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Detected frameworks, CMS, libraries"
    },
    "reasoning": {
      "type": "string",
      "description": "Explanation of why this classification was chosen"
    }
  }
}
